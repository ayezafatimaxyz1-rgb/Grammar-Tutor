<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <script src="./support.js"></script>
</head>
<body>
<x-dc>
<helmet>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:opsz,wght@6..96,400&family=Jost:wght@300;400;500&display=swap">
  <style>
    body { margin: 0; }
    a { color: #B08D57; } a:hover { color: #E8D2A6; }
  </style>
</helmet>

<div style="width: 1440px; height: 660px; box-sizing: border-box; padding: 40px 48px 34px; background: #17150F; font-family: Jost, sans-serif; color: #E8E3DA;">

  <svg width="0" height="0" style="position:absolute" aria-hidden="true">
    <linearGradient id="sqBrass" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#4A3720"/><stop offset="0.44" stop-color="#D8BB84"/>
      <stop offset="0.58" stop-color="#F2E2C0"/><stop offset="1" stop-color="#3E2D19"/>
    </linearGradient>
  </svg>

  <div style="display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 26px;">
    <div style="font-family: 'Bodoni Moda', Didot, serif; font-size: 25px;">The opening sequence</div>
    <div style="font-size: 10px; letter-spacing: 0.22em; text-transform: uppercase; color: rgba(232,227,218,0.42);">One scroll &middot; five beats &middot; then the shop begins</div>
  </div>

  <div style="display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 18px;">

    <!-- 00 -->
    <div style="display: flex; flex-direction: column; gap: 14px;">
      <div style="height: 286px; background: #070706; border: 1px solid rgba(232,227,218,0.08); display: flex; align-items: center; justify-content: center; position: relative;">
        <div style="font-family: 'Bodoni Moda', serif; font-size: 13px; letter-spacing: 0.4em; padding-left: 0.4em; color: rgba(232,227,218,0.2);">MARKHOOR</div>
      </div>
      <div style="display: flex; flex-direction: column; gap: 6px;">
        <div style="font-size: 9px; letter-spacing: 0.24em; color: rgba(176,141,87,0.9);">00 &mdash; 0%</div>
        <div style="font-family: 'Bodoni Moda', serif; font-size: 17px; color: #F3EFE8;">Dark</div>
        <div style="font-size: 11.5px; font-weight: 300; line-height: 1.62; color: rgba(232,227,218,0.5);">Nothing but the name. Two seconds of quiet before anything moves.</div>
      </div>
    </div>

    <!-- 01 -->
    <div style="display: flex; flex-direction: column; gap: 14px;">
      <div style="height: 286px; background: #070706; border: 1px solid rgba(232,227,218,0.08); display: flex; align-items: center; justify-content: center; position: relative; overflow: hidden;">
        <div style="position: absolute; inset: 0; background: radial-gradient(48% 42% at 50% 46%, rgba(176,141,87,0.2), rgba(0,0,0,0) 70%);"></div>
        <svg viewBox="-34 -272 96 286" width="52" height="155" style="overflow: visible; position: relative;"><!--HORN sq 0.68--></svg>
      </div>
      <div style="display: flex; flex-direction: column; gap: 6px;">
        <div style="font-size: 9px; letter-spacing: 0.24em; color: rgba(176,141,87,0.9);">01 &mdash; 20%</div>
        <div style="font-family: 'Bodoni Moda', serif; font-size: 17px; color: #F3EFE8;">The horn</div>
        <div style="font-size: 11.5px; font-weight: 300; line-height: 1.62; color: rgba(232,227,218,0.5);">Brass turns up out of the black and rotates once, slowly.</div>
      </div>
    </div>

    <!-- 02 -->
    <div style="display: flex; flex-direction: column; gap: 14px;">
      <div style="height: 286px; background: #070706; border: 1px solid rgba(232,227,218,0.08); display: flex; align-items: center; justify-content: center; position: relative; overflow: hidden;">
        <div style="position: absolute; inset: 0; background: radial-gradient(60% 50% at 50% 40%, rgba(176,141,87,0.1), rgba(0,0,0,0) 72%);"></div>
        <svg viewBox="0 0 240 286" width="240" height="286" style="position: relative;">
          <g stroke="#B08D57" stroke-opacity="0.72" stroke-width="1.6" fill="none">
            <path d="M42,28 V262 M120,20 V268 M198,28 V262"/>
            <path d="M42,96 H198 M42,176 H198"/>
          </g>
          <g stroke="#E8D2A6" stroke-opacity="0.3" stroke-width="1" fill="none">
            <path d="M42,262 H198"/>
          </g>
          <g fill="#B08D57" fill-opacity="0.6">
            <circle cx="42" cy="96" r="2.6"/><circle cx="120" cy="96" r="2.6"/><circle cx="198" cy="96" r="2.6"/>
            <circle cx="42" cy="176" r="2.6"/><circle cx="120" cy="176" r="2.6"/><circle cx="198" cy="176" r="2.6"/>
          </g>
        </svg>
      </div>
      <div style="display: flex; flex-direction: column; gap: 6px;">
        <div style="font-size: 9px; letter-spacing: 0.24em; color: rgba(176,141,87,0.9);">02 &mdash; 45%</div>
        <div style="font-family: 'Bodoni Moda', serif; font-size: 17px; color: #F3EFE8;">Rails span</div>
        <div style="font-size: 11.5px; font-weight: 300; line-height: 1.62; color: rgba(232,227,218,0.5);">Uprights rise floor to ceiling, then the rails draw across between them.</div>
      </div>
    </div>

    <!-- 03 -->
    <div style="display: flex; flex-direction: column; gap: 14px;">
      <div style="height: 286px; background: #070706; border: 1px solid rgba(232,227,218,0.08); display: flex; align-items: center; justify-content: center; position: relative; overflow: hidden;">
        <div style="position: absolute; inset: 0; background: radial-gradient(60% 50% at 50% 38%, rgba(176,141,87,0.14), rgba(0,0,0,0) 72%);"></div>
        <svg viewBox="0 0 240 286" width="240" height="286" style="position: relative;">
          <g stroke="#B08D57" stroke-opacity="0.72" stroke-width="1.6" fill="none">
            <path d="M42,28 V262 M120,20 V268 M198,28 V262 M42,96 H198 M42,176 H198"/>
          </g>
          <g>
            <path transform="translate(52,96) scale(0.62)" d="M22,7 L36,14 L39,36 L35,34 L35,86 L9,86 L9,34 L5,36 L8,14 Z" fill="#1A1614"/>
            <path transform="translate(88,96) scale(0.62)" d="M22,7 L36,14 L39,36 L35,34 L35,86 L9,86 L9,34 L5,36 L8,14 Z" fill="#5A3A2E"/>
            <path transform="translate(124,96) scale(0.62)" d="M22,7 L36,14 L39,36 L35,34 L35,86 L9,86 L9,34 L5,36 L8,14 Z" fill="#5C1F2A"/>
            <path transform="translate(160,96) scale(0.62)" d="M22,7 L36,14 L39,36 L35,34 L35,86 L9,86 L9,34 L5,36 L8,14 Z" fill="#4A3225"/>
            <path transform="translate(70,176) scale(0.62)" d="M22,7 L36,14 L39,36 L35,34 L35,86 L9,86 L9,34 L5,36 L8,14 Z" fill="#1A1614"/>
            <path transform="translate(112,176) scale(0.62)" d="M22,7 L36,14 L39,36 L35,34 L35,86 L9,86 L9,34 L5,36 L8,14 Z" fill="#5A3A2E"/>
            <path transform="translate(148,176) scale(0.62)" d="M22,7 L36,14 L39,36 L35,34 L35,86 L9,86 L9,34 L5,36 L8,14 Z" fill="#5C1F2A"/>
          </g>
        </svg>
      </div>
      <div style="display: flex; flex-direction: column; gap: 6px;">
        <div style="font-size: 9px; letter-spacing: 0.24em; color: rgba(176,141,87,0.9);">03 &mdash; 70%</div>
        <div style="font-family: 'Bodoni Moda', serif; font-size: 17px; color: #F3EFE8;">The line hangs</div>
        <div style="font-size: 11.5px; font-weight: 300; line-height: 1.62; color: rgba(232,227,218,0.5);">Your five jackets fade onto the rails one at a time, left to right.</div>
      </div>
    </div>

    <!-- 04 -->
    <div style="display: flex; flex-direction: column; gap: 14px;">
      <div style="height: 286px; background: #0B0A09; border: 1px solid rgba(176,141,87,0.24); display: flex; align-items: center; justify-content: center; position: relative; overflow: hidden;">
        <div style="position: absolute; inset: 0; background: radial-gradient(70% 58% at 50% 34%, rgba(176,141,87,0.32), rgba(0,0,0,0) 74%);"></div>
        <svg viewBox="0 0 240 286" width="240" height="286" style="position: relative;">
          <g stroke="#E8D2A6" stroke-opacity="0.85" stroke-width="1.6" fill="none">
            <path d="M42,28 V262 M120,20 V268 M198,28 V262 M42,96 H198 M42,176 H198"/>
          </g>
          <g>
            <path transform="translate(52,96) scale(0.62)" d="M22,7 L36,14 L39,36 L35,34 L35,86 L9,86 L9,34 L5,36 L8,14 Z" fill="#2A2422"/>
            <path transform="translate(88,96) scale(0.62)" d="M22,7 L36,14 L39,36 L35,34 L35,86 L9,86 L9,34 L5,36 L8,14 Z" fill="#7A5740"/>
            <path transform="translate(124,96) scale(0.62)" d="M22,7 L36,14 L39,36 L35,34 L35,86 L9,86 L9,34 L5,36 L8,14 Z" fill="#8E3A46"/>
            <path transform="translate(160,96) scale(0.62)" d="M22,7 L36,14 L39,36 L35,34 L35,86 L9,86 L9,34 L5,36 L8,14 Z" fill="#6A4534"/>
            <path transform="translate(70,176) scale(0.62)" d="M22,7 L36,14 L39,36 L35,34 L35,86 L9,86 L9,34 L5,36 L8,14 Z" fill="#2A2422"/>
            <path transform="translate(112,176) scale(0.62)" d="M22,7 L36,14 L39,36 L35,34 L35,86 L9,86 L9,34 L5,36 L8,14 Z" fill="#7A5740"/>
            <path transform="translate(148,176) scale(0.62)" d="M22,7 L36,14 L39,36 L35,34 L35,86 L9,86 L9,34 L5,36 L8,14 Z" fill="#8E3A46"/>
          </g>
        </svg>
        <div style="position: absolute; bottom: 22px; left: 50%; transform: translateX(-50%); padding: 9px 18px; border: 1px solid rgba(176,141,87,0.85); color: #E8D2A6; font-size: 8px; letter-spacing: 0.2em; white-space: nowrap;">SEE THE COLLECTION</div>
      </div>
      <div style="display: flex; flex-direction: column; gap: 6px;">
        <div style="font-size: 9px; letter-spacing: 0.24em; color: rgba(176,141,87,0.9);">04 &mdash; 100%</div>
        <div style="font-family: 'Bodoni Moda', serif; font-size: 17px; color: #F3EFE8;">Light</div>
        <div style="font-size: 11.5px; font-weight: 300; line-height: 1.62; color: rgba(232,227,218,0.5);">Warm light comes up, the call to action lands, and the motion stops for good.</div>
      </div>
    </div>

  </div>

  <div style="margin-top: 28px; display: flex; align-items: center; gap: 16px;">
    <div style="font-size: 9px; letter-spacing: 0.2em; color: rgba(232,227,218,0.34); white-space: nowrap;">SCROLL DEPTH</div>
    <div style="flex-grow: 1; height: 2px; background: linear-gradient(to right, rgba(176,141,87,0.15), #B08D57);"></div>
    <div style="font-size: 9px; letter-spacing: 0.2em; color: rgba(232,227,218,0.34); white-space: nowrap;">~2.5 SCREENS, THEN NORMAL PAGE</div>
  </div>
</div>
</x-dc>
</body>
</html>
