<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <script src="./support.js"></script>
</head>
<body>
<x-dc>
<helmet>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;800;900&family=Instrument+Serif:ital@0;1&display=swap">
  <style>
    body { margin: 0; }
    a { color: #5C1F2A; } a:hover { color: #8E3A46; }
  </style>
</helmet>

<div style="width: 1440px; height: 900px; box-sizing: border-box; background: #E8E3DA; font-family: Archivo, sans-serif; color: #17130F; position: relative; overflow: hidden;">

  <svg width="0" height="0" style="position:absolute" aria-hidden="true">
    <radialGradient id="daSheen" cx="0.3" cy="0.18" r="0.62">
      <stop offset="0" stop-color="#FFFFFF" stop-opacity="0.3"/><stop offset="1" stop-color="#FFFFFF" stop-opacity="0"/>
    </radialGradient>
  </svg>

  <div style="position: absolute; top: 20px; left: 48px; font-size: 9px; letter-spacing: 0.24em; color: #5C1F2A;">DIRECTION A &mdash; BONE ATELIER</div>

  <!-- nav -->
  <div style="height: 68px; margin-top: 40px; display: flex; align-items: center; justify-content: space-between; padding: 0 48px; box-sizing: border-box; border-bottom: 1px solid rgba(23,19,15,0.16);">
    <div style="display: flex; gap: 30px; font-size: 10.5px; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase;">
      <span>Men</span><span>Women</span><span style="color: rgba(23,19,15,0.45);">The Markhor</span>
    </div>
    <div style="display: flex; gap: 20px; align-items: center; font-size: 10.5px; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase;">
      <span>Search</span><span style="color: #5C1F2A;">Bag (0)</span>
    </div>
  </div>

  <div style="display: grid; grid-template-columns: 1fr 1fr; height: 640px;">

    <!-- type block -->
    <div style="padding: 62px 0 0 48px; display: flex; flex-direction: column; justify-content: space-between;">
      <div style="display: flex; flex-direction: column; gap: 22px;">
        <div style="display: flex; align-items: center; gap: 14px;">
          <svg viewBox="-34 -272 96 286" width="17" height="51" style="overflow: visible;"><!--HORNLINE #17130F 8--></svg>
          <div style="font-size: 10px; font-weight: 600; letter-spacing: 0.26em; text-transform: uppercase; color: #5C1F2A;">Five jackets &middot; United Arab Emirates</div>
        </div>

        <h1 style="margin: 0; font-weight: 900; font-size: 116px; line-height: 0.84; letter-spacing: -0.045em; text-transform: uppercase;">Built<br>for the<br><span style="font-family: 'Instrument Serif', Georgia, serif; font-weight: 400; font-style: italic; letter-spacing: -0.01em; text-transform: none; font-size: 122px;">climb</span></h1>

        <div style="display: flex; gap: 16px; align-items: flex-start; max-width: 430px; margin-top: 8px;">
          <div style="width: 46px; height: 2px; background: #5C1F2A; margin-top: 11px; flex-shrink: 0;"></div>
          <p style="margin: 0; font-size: 14px; font-weight: 400; line-height: 1.68; color: rgba(23,19,15,0.66); text-wrap: pretty;">Named for the markhor, the horned goat that holds the cliff when nothing else can. Cut heavy, worn close, delivered anywhere in the Emirates inside two days.</p>
        </div>
      </div>

      <div style="display: flex; gap: 12px; padding-bottom: 8px;">
        <div style="padding: 17px 34px; background: #17130F; color: #E8E3DA; font-size: 10.5px; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase;">Shop the line</div>
        <div style="padding: 17px 34px; border: 1px solid rgba(23,19,15,0.28); font-size: 10.5px; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase;">Our story</div>
      </div>
    </div>

    <!-- product plate -->
    <div style="position: relative; display: flex; align-items: center; justify-content: center;">
      <div style="position: absolute; width: 470px; height: 470px; border-radius: 50%; background: #5C1F2A;"></div>
      <div style="position: absolute; width: 470px; height: 470px; border-radius: 50%; border: 1px solid rgba(23,19,15,0.2); transform: translate(26px, -26px);"></div>
      <svg viewBox="0 0 320 300" width="440" height="413" style="position: relative; filter: drop-shadow(0 26px 40px rgba(23,19,15,0.36));">
        <path d="M186,38 L248,58 C280,72 300,116 300,168 L298,206 L254,212 C256,180 250,140 236,112 L236,248 L84,248 L84,112 C70,140 64,180 66,212 L22,206 L20,168 C20,116 40,72 72,58 L134,38 C150,45 170,45 186,38 Z" fill="#1A1614"/>
        <path d="M236,112 L236,248 L160,248 L160,52 L184,38 L248,58 C280,72 300,116 300,168 L298,206 L254,212 C256,180 250,140 236,112 Z" fill="#000" fill-opacity="0.17"/>
        <rect x="84" y="220" width="152" height="28" fill="#000" fill-opacity="0.34"/>
        <path d="M21,180 L67,194 L66,212 L22,206 Z" fill="#000" fill-opacity="0.3"/>
        <path d="M299,180 L253,194 L254,212 L298,206 Z" fill="#000" fill-opacity="0.3"/>
        <rect x="157" y="56" width="6" height="166" fill="#000" fill-opacity="0.45"/>
        <line x1="160" y1="58" x2="160" y2="220" stroke="#C9BCA6" stroke-opacity="0.45" stroke-width="2.2" stroke-dasharray="1.6 3.4"/>
        <path d="M136,38 L160,56 L142,88 L120,50 Z" fill="#FFF" fill-opacity="0.09"/>
        <path d="M184,38 L160,56 L178,88 L200,50 Z" fill="#000" fill-opacity="0.18"/>
        <g fill="none" stroke="#000" stroke-opacity="0.34" stroke-width="1.3">
          <rect x="100" y="120" width="48" height="46" rx="2"/><rect x="98" y="114" width="52" height="15" rx="2"/>
          <rect x="172" y="120" width="48" height="46" rx="2"/><rect x="170" y="114" width="52" height="15" rx="2"/>
        </g>
        <ellipse cx="116" cy="94" rx="72" ry="54" fill="url(#daSheen)"/>
      </svg>
      <div style="position: absolute; right: 48px; bottom: 34px; text-align: right;">
        <div style="font-family: 'Instrument Serif', Georgia, serif; font-size: 26px; line-height: 1.1;">The Ridge</div>
        <div style="font-size: 12px; font-weight: 500; color: rgba(23,19,15,0.6); margin-top: 3px;">AED 137</div>
      </div>
    </div>
  </div>

  <!-- index strip -->
  <div style="position: absolute; left: 0; right: 0; bottom: 0; height: 84px; border-top: 1px solid rgba(23,19,15,0.16); display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); align-items: center;">
    <div style="padding: 0 24px 0 48px; display: flex; justify-content: space-between; align-items: baseline; border-right: 1px solid rgba(23,19,15,0.12);"><span style="font-size: 12.5px; font-weight: 500;">001 &nbsp;The Ridge</span><span style="font-size: 11px; color: rgba(23,19,15,0.5);">137</span></div>
    <div style="padding: 0 24px; display: flex; justify-content: space-between; align-items: baseline; border-right: 1px solid rgba(23,19,15,0.12);"><span style="font-size: 12.5px; font-weight: 500;">002 &nbsp;The Drift</span><span style="font-size: 11px; color: rgba(23,19,15,0.5);">49</span></div>
    <div style="padding: 0 24px; display: flex; justify-content: space-between; align-items: baseline; border-right: 1px solid rgba(23,19,15,0.12);"><span style="font-size: 12.5px; font-weight: 500;">003 &nbsp;The Hunza</span><span style="font-size: 11px; color: rgba(23,19,15,0.5);">74</span></div>
    <div style="padding: 0 24px; display: flex; justify-content: space-between; align-items: baseline; border-right: 1px solid rgba(23,19,15,0.12);"><span style="font-size: 12.5px; font-weight: 500;">004 &nbsp;The Maillard</span><span style="font-size: 11px; color: rgba(23,19,15,0.5);">97</span></div>
    <div style="padding: 0 48px 0 24px; display: flex; justify-content: space-between; align-items: baseline;"><span style="font-size: 12.5px; font-weight: 500;">005 &nbsp;The Ember</span><span style="font-size: 11px; color: rgba(23,19,15,0.5);">60</span></div>
  </div>
</div>
</x-dc>
</body>
</html>
