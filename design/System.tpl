<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <script src="./support.js"></script>
</head>
<body>
<x-dc>
<helmet>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:opsz,wght@6..96,400;6..96,500&family=Jost:wght@300;400;500&display=swap">
  <style>
    body { margin: 0; }
    a { color: #B08D57; } a:hover { color: #E8D2A6; }
  </style>
</helmet>

<div style="width: 1440px; height: 840px; box-sizing: border-box; padding: 44px 48px; background: #17150F; font-family: Jost, sans-serif; color: #E8E3DA;">

  <div style="display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 30px;">
    <div style="font-family: 'Bodoni Moda', Didot, serif; font-size: 25px;">Colour, type, and where motion is allowed</div>
    <div style="font-size: 10px; letter-spacing: 0.22em; text-transform: uppercase; color: rgba(232,227,218,0.42);">Every colour taken from a jacket you already sell</div>
  </div>

  <!-- palette -->
  <div style="display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 12px; margin-bottom: 34px;">
    <div style="display: flex; flex-direction: column; gap: 10px;">
      <div style="height: 104px; background: #0B0A09; border: 1px solid rgba(232,227,218,0.12);"></div>
      <div style="font-size: 12px;">Ink</div><div style="font-size: 10px; color: rgba(232,227,218,0.4);">#0B0A09 &middot; page</div>
    </div>
    <div style="display: flex; flex-direction: column; gap: 10px;">
      <div style="height: 104px; background: #1A1614;"></div>
      <div style="font-size: 12px;">Hide Black</div><div style="font-size: 10px; color: rgba(232,227,218,0.4);">#1A1614 &middot; 001, 003</div>
    </div>
    <div style="display: flex; flex-direction: column; gap: 10px;">
      <div style="height: 104px; background: #4A3225;"></div>
      <div style="font-size: 12px;">Coffee</div><div style="font-size: 10px; color: rgba(232,227,218,0.4);">#4A3225 &middot; 002</div>
    </div>
    <div style="display: flex; flex-direction: column; gap: 10px;">
      <div style="height: 104px; background: #5A3A2E;"></div>
      <div style="font-size: 12px;">Maillard</div><div style="font-size: 10px; color: rgba(232,227,218,0.4);">#5A3A2E &middot; 004</div>
    </div>
    <div style="display: flex; flex-direction: column; gap: 10px;">
      <div style="height: 104px; background: #5C1F2A;"></div>
      <div style="font-size: 12px;">Burgundy</div><div style="font-size: 10px; color: rgba(232,227,218,0.4);">#5C1F2A &middot; 005</div>
    </div>
    <div style="display: flex; flex-direction: column; gap: 10px;">
      <div style="height: 104px; background: #B08D57;"></div>
      <div style="font-size: 12px;">Brass</div><div style="font-size: 10px; color: rgba(232,227,218,0.4);">#B08D57 &middot; horn, CTA</div>
    </div>
    <div style="display: flex; flex-direction: column; gap: 10px;">
      <div style="height: 104px; background: #E8E3DA;"></div>
      <div style="font-size: 12px;">Bone</div><div style="font-size: 10px; color: rgba(232,227,218,0.4);">#E8E3DA &middot; type</div>
    </div>
  </div>

  <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 40px;">

    <!-- type -->
    <div style="display: flex; flex-direction: column; gap: 22px;">
      <div style="font-size: 10px; letter-spacing: 0.22em; text-transform: uppercase; color: rgba(176,141,87,0.9);">Typography</div>

      <div style="display: flex; flex-direction: column; gap: 6px; padding-bottom: 20px; border-bottom: 1px solid rgba(232,227,218,0.1);">
        <div style="font-family: 'Bodoni Moda', Didot, serif; font-size: 54px; line-height: 1.05;">Built for the climb</div>
        <div style="font-size: 10.5px; color: rgba(232,227,218,0.44);">Bodoni Moda &middot; 400 &middot; headlines, product names, the wordmark</div>
      </div>

      <div style="display: flex; flex-direction: column; gap: 6px; padding-bottom: 20px; border-bottom: 1px solid rgba(232,227,218,0.1);">
        <div style="font-size: 15px; font-weight: 300; line-height: 1.72; color: rgba(232,227,218,0.76); max-width: 460px;">Double-layer collar, zip hand pockets, elasticated hem. Cut loose through the shoulder so it sits over a knit without pulling.</div>
        <div style="font-size: 10.5px; color: rgba(232,227,218,0.44);">Jost &middot; 300 &middot; body copy, descriptions</div>
      </div>

      <div style="display: flex; flex-direction: column; gap: 8px;">
        <div style="font-size: 11px; letter-spacing: 0.2em; text-transform: uppercase; color: #E8D2A6;">Add to bag &nbsp;&middot;&nbsp; Size guide &nbsp;&middot;&nbsp; Free shipping</div>
        <div style="font-size: 10.5px; color: rgba(232,227,218,0.44);">Jost &middot; 500 &middot; uppercase, 0.2em tracking &middot; buttons, labels, navigation</div>
      </div>
    </div>

    <!-- motion rules -->
    <div style="display: flex; flex-direction: column; gap: 18px;">
      <div style="font-size: 10px; letter-spacing: 0.22em; text-transform: uppercase; color: rgba(176,141,87,0.9);">Where motion is allowed</div>

      <div style="display: flex; gap: 16px; align-items: flex-start; padding: 16px 0; border-bottom: 1px solid rgba(232,227,218,0.1);">
        <div style="width: 30px; font-family: 'Bodoni Moda', serif; font-size: 20px; color: #E8D2A6; flex-shrink: 0;">01</div>
        <div style="display: flex; flex-direction: column; gap: 5px;">
          <div style="font-size: 14px;">The opening sequence</div>
          <div style="font-size: 12px; font-weight: 300; line-height: 1.6; color: rgba(232,227,218,0.5);">Roughly two and a half screens of scroll, once, at the very top. Then it is over and never returns.</div>
        </div>
      </div>

      <div style="display: flex; gap: 16px; align-items: flex-start; padding: 16px 0; border-bottom: 1px solid rgba(232,227,218,0.1);">
        <div style="width: 30px; font-family: 'Bodoni Moda', serif; font-size: 20px; color: #E8D2A6; flex-shrink: 0;">02</div>
        <div style="display: flex; flex-direction: column; gap: 5px;">
          <div style="font-size: 14px;">The product turntable</div>
          <div style="font-size: 12px; font-weight: 300; line-height: 1.6; color: rgba(232,227,218,0.5);">Scroll turns the jacket through its angles. The only motion on a product page.</div>
        </div>
      </div>

      <div style="display: flex; gap: 16px; align-items: flex-start; padding: 16px 0; border-bottom: 1px solid rgba(232,227,218,0.1);">
        <div style="width: 30px; font-family: 'Bodoni Moda', serif; font-size: 20px; color: rgba(232,227,218,0.3); flex-shrink: 0;">03</div>
        <div style="display: flex; flex-direction: column; gap: 5px;">
          <div style="font-size: 14px; color: rgba(232,227,218,0.68);">Everywhere else &mdash; nothing</div>
          <div style="font-size: 12px; font-weight: 300; line-height: 1.6; color: rgba(232,227,218,0.5);">Grid, cart, checkout stay still and fast. A shop that makes people wait does not sell.</div>
        </div>
      </div>

      <div style="display: flex; gap: 16px; align-items: flex-start; padding: 16px 18px; background: rgba(92,31,42,0.16); border-left: 2px solid #5C1F2A;">
        <div style="display: flex; flex-direction: column; gap: 5px;">
          <div style="font-size: 14px;">On a phone, none of it runs</div>
          <div style="font-size: 12px; font-weight: 300; line-height: 1.6; color: rgba(232,227,218,0.58);">Most of your UAE traffic is mobile. Phones get a still hero and a swipeable gallery. Anyone with reduced motion switched on gets the same. This is not a downgrade, it is the version that sells.</div>
        </div>
      </div>
    </div>

  </div>
</div>
</x-dc>
</body>
</html>
