<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <script src="./support.js"></script>
</head>
<body>
<x-dc>
<helmet>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:opsz,wght@6..96,400;6..96,500;6..96,700&family=Jost:wght@300;400;500;600&family=Archivo:wght@500;700;800&display=swap">
  <style>
    body { margin: 0; }
    a { color: #B08D57; } a:hover { color: #E8D2A6; }
  </style>
</helmet>

<div style="width: 1440px; height: 820px; box-sizing: border-box; padding: 44px 48px 48px; background: #17150F; font-family: Jost, sans-serif; color: #E8E3DA; position: relative; overflow: hidden;">

  <svg width="0" height="0" style="position:absolute" aria-hidden="true">
    <filter id="wmGrain"><feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="3" stitchTiles="stitch"/><feColorMatrix type="saturate" values="0"/></filter>
  </svg>

  <div style="display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 30px;">
    <div style="font-family: 'Bodoni Moda', Didot, serif; font-size: 25px; letter-spacing: 0.02em;">Wordmark directions</div>
    <div style="font-size: 10px; letter-spacing: 0.22em; text-transform: uppercase; color: rgba(232,227,218,0.42);">Four ways the name can carry</div>
  </div>

  <div style="display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 26px;">

    <!-- 01 EDITORIAL -->
    <div style="height: 316px; background: #0B0A09; border: 1px solid rgba(232,227,218,0.09); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 22px; position: relative;">
      <div style="position: absolute; top: 16px; left: 18px; font-size: 9px; letter-spacing: 0.24em; color: rgba(176,141,87,0.85);">01 &mdash; EDITORIAL</div>
      <svg viewBox="-34 -272 96 286" width="34" height="101" style="overflow: visible;"><!--HORN wa 0.7--></svg>
      <div style="display: flex; flex-direction: column; align-items: center; gap: 12px;">
        <div style="font-family: 'Bodoni Moda', Didot, serif; font-size: 40px; letter-spacing: 0.44em; padding-left: 0.44em; color: #F3EFE8;">MARKHOOR</div>
        <div style="display: flex; align-items: center; gap: 14px;">
          <div style="width: 52px; height: 1px; background: rgba(176,141,87,0.55);"></div>
          <div style="font-size: 9px; letter-spacing: 0.3em; color: rgba(232,227,218,0.5);">LEATHER</div>
          <div style="width: 52px; height: 1px; background: rgba(176,141,87,0.55);"></div>
        </div>
      </div>
    </div>

    <!-- 02 MONOGRAM -->
    <div style="height: 316px; background: #0B0A09; border: 1px solid rgba(232,227,218,0.09); display: flex; align-items: center; justify-content: center; gap: 34px; position: relative;">
      <div style="position: absolute; top: 16px; left: 18px; font-size: 9px; letter-spacing: 0.24em; color: rgba(176,141,87,0.85);">02 &mdash; HORN MONOGRAM</div>
      <div style="width: 136px; height: 136px; border: 1px solid rgba(176,141,87,0.42); border-radius: 50%; display: flex; align-items: center; justify-content: center;">
        <svg viewBox="-34 -272 96 286" width="34" height="101" style="overflow: visible;"><!--HORN wb 0.7--></svg>
      </div>
      <div style="display: flex; flex-direction: column; gap: 9px;">
        <div style="font-family: 'Bodoni Moda', Didot, serif; font-size: 34px; letter-spacing: 0.2em; color: #F3EFE8; line-height: 1;">MARKHOOR</div>
        <div style="font-size: 9.5px; letter-spacing: 0.26em; color: rgba(232,227,218,0.45);">HIGH COUNTRY LEATHER</div>
      </div>
    </div>

    <!-- 03 STAMPED -->
    <div style="height: 316px; background: #4A3225; border: 1px solid rgba(0,0,0,0.4); display: flex; align-items: center; justify-content: center; position: relative; overflow: hidden;">
      <div style="position: absolute; inset: 0; background: radial-gradient(70% 90% at 30% 20%, rgba(150,106,74,0.55), rgba(0,0,0,0) 60%), radial-gradient(80% 70% at 78% 82%, rgba(0,0,0,0.5), rgba(0,0,0,0) 62%);"></div>
      <div style="position: absolute; inset: 0; filter: url(#wmGrain); opacity: 0.4; mix-blend-mode: overlay;"></div>
      <div style="position: absolute; top: 16px; left: 18px; font-size: 9px; letter-spacing: 0.24em; color: rgba(255,233,205,0.72); z-index: 2;">03 &mdash; DEBOSSED INTO HIDE</div>
      <div style="position: relative; z-index: 2; display: flex; flex-direction: column; align-items: center; gap: 16px; padding: 30px 46px; border: 1.5px solid rgba(29,17,10,0.42); box-shadow: inset 0 1.5px 0 rgba(255,226,186,0.16), 0 1.5px 0 rgba(255,226,186,0.1);">
        <div style="font-family: 'Bodoni Moda', Didot, serif; font-size: 37px; letter-spacing: 0.32em; padding-left: 0.32em; color: #2B1A10; text-shadow: 0 1.5px 0 rgba(255,222,180,0.28);">MARKHOOR</div>
        <div style="font-size: 9px; letter-spacing: 0.3em; color: rgba(43,26,16,0.72); text-shadow: 0 1px 0 rgba(255,222,180,0.22);">GENUINE &middot; DUBAI &middot; 2026</div>
      </div>
    </div>

    <!-- 04 TECHNICAL -->
    <div style="height: 316px; background: #E8E3DA; border: 1px solid rgba(0,0,0,0.12); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 18px; position: relative; overflow: hidden;">
      <div style="position: absolute; inset: 0; background-image: linear-gradient(rgba(23,19,16,0.05) 1px, transparent 1px), linear-gradient(90deg, rgba(23,19,16,0.05) 1px, transparent 1px); background-size: 26px 26px;"></div>
      <div style="position: absolute; top: 16px; left: 18px; font-size: 9px; letter-spacing: 0.24em; color: rgba(92,31,42,0.85);">04 &mdash; TECHNICAL</div>
      <div style="position: relative; display: flex; align-items: center; gap: 18px;">
        <svg viewBox="-34 -272 96 286" width="22" height="66" style="overflow: visible;"><!--HORNLINE #17130F 7--></svg>
        <div style="display: flex; flex-direction: column; align-items: flex-start; gap: 13px;">
          <div style="font-family: Archivo, sans-serif; font-weight: 800; font-size: 52px; letter-spacing: -0.018em; color: #17130F; line-height: 1;">MARKHOOR</div>
          <div style="display: flex; gap: 0; border: 1px solid rgba(23,19,16,0.24); font-size: 9px; letter-spacing: 0.18em; color: rgba(23,19,16,0.7);">
            <span style="padding: 7px 14px; border-right: 1px solid rgba(23,19,16,0.24);">CAPRA FALCONERI</span>
            <span style="padding: 7px 14px; border-right: 1px solid rgba(23,19,16,0.24);">AE</span>
            <span style="padding: 7px 14px; color: #5C1F2A;">NO. 001&ndash;005</span>
          </div>
        </div>
      </div>
    </div>

  </div>
</div>
</x-dc>
</body>
</html>
