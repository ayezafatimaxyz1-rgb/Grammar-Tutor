<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <script src="./support.js"></script>
</head>
<body>
<x-dc>
<helmet>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&family=Archivo:wght@600;800;900&display=swap">
  <style>
    body { margin: 0; }
    a { color: #B08D57; } a:hover { color: #E8D2A6; }
  </style>
</helmet>

<div style="width: 1440px; height: 900px; box-sizing: border-box; background: #14120D; font-family: 'Space Mono', monospace; color: #E8E3DA; position: relative; overflow: hidden;">

  <div style="position: absolute; inset: 0; background-image: linear-gradient(rgba(232,227,218,0.045) 1px, transparent 1px), linear-gradient(90deg, rgba(232,227,218,0.045) 1px, transparent 1px); background-size: 40px 40px;"></div>

  <!-- registration corners -->
  <svg width="1440" height="900" style="position: absolute; inset: 0; pointer-events: none;" fill="none" stroke="rgba(176,141,87,0.5)" stroke-width="1">
    <path d="M28 44 V28 H44 M1396 28 H1412 V44 M1412 856 V872 H1396 M44 872 H28 V856"/>
  </svg>

  <div style="position: absolute; top: 26px; left: 48px; font-size: 9px; letter-spacing: 0.2em; color: #B08D57;">DIRECTION B &mdash; FIELD MANUAL</div>

  <!-- header -->
  <div style="position: absolute; top: 62px; left: 48px; right: 48px; display: flex; justify-content: space-between; align-items: center; padding-bottom: 18px; border-bottom: 1px solid rgba(232,227,218,0.14);">
    <div style="display: flex; gap: 26px; font-size: 10px; letter-spacing: 0.1em;">
      <span style="color: #B08D57;">[MEN]</span><span style="color: rgba(232,227,218,0.55);">[WOMEN]</span><span style="color: rgba(232,227,218,0.55);">[THE MARKHOR]</span>
    </div>
    <div style="font-weight: 700; font-size: 15px; letter-spacing: 0.5em; padding-left: 0.5em;">MARKHOOR</div>
    <div style="font-size: 10px; letter-spacing: 0.1em; color: rgba(232,227,218,0.55);">[BAG 00]</div>
  </div>

  <!-- spec stage -->
  <svg viewBox="0 0 1344 560" width="1344" height="560" style="position: absolute; top: 132px; left: 48px;">
    <g font-family="'Space Mono', monospace" font-size="10.5" letter-spacing="1.4">

      <!-- jacket -->
      <g transform="translate(512,120) scale(1.06)">
        <path d="M186,38 L248,58 C280,72 300,116 300,168 L298,206 L254,212 C256,180 250,140 236,112 L236,248 L84,248 L84,112 C70,140 64,180 66,212 L22,206 L20,168 C20,116 40,72 72,58 L134,38 C150,45 170,45 186,38 Z" fill="#241C15" stroke="#B08D57" stroke-opacity="0.55" stroke-width="1.2"/>
        <path d="M236,112 L236,248 L160,248 L160,52 L184,38 L248,58 C280,72 300,116 300,168 L298,206 L254,212 C256,180 250,140 236,112 Z" fill="#000" fill-opacity="0.28"/>
        <rect x="84" y="220" width="152" height="28" fill="#000" fill-opacity="0.34" stroke="#B08D57" stroke-opacity="0.3" stroke-width="1"/>
        <path d="M21,180 L67,194 L66,212 L22,206 Z" fill="#000" fill-opacity="0.32" stroke="#B08D57" stroke-opacity="0.3" stroke-width="1"/>
        <path d="M299,180 L253,194 L254,212 L298,206 Z" fill="#000" fill-opacity="0.32" stroke="#B08D57" stroke-opacity="0.3" stroke-width="1"/>
        <rect x="157" y="56" width="6" height="166" fill="#0C0A07"/>
        <line x1="160" y1="58" x2="160" y2="220" stroke="#B08D57" stroke-opacity="0.75" stroke-width="2.2" stroke-dasharray="1.6 3.2"/>
        <path d="M136,38 L160,56 L142,88 L120,50 Z" fill="#3A2E23" stroke="#B08D57" stroke-opacity="0.45" stroke-width="1"/>
        <path d="M184,38 L160,56 L178,88 L200,50 Z" fill="#1C1611" stroke="#B08D57" stroke-opacity="0.45" stroke-width="1"/>
        <g fill="none" stroke="#B08D57" stroke-opacity="0.45" stroke-width="1.1">
          <rect x="100" y="120" width="48" height="46"/><rect x="98" y="114" width="52" height="15"/>
          <rect x="172" y="120" width="48" height="46"/><rect x="170" y="114" width="52" height="15"/>
        </g>
      </g>

      <!-- leaders: left -->
      <g stroke="#B08D57" stroke-opacity="0.7" stroke-width="1" fill="none">
        <path d="M300,192 H648"/><path d="M300,300 H618"/><path d="M300,416 H608"/>
      </g>
      <g fill="#E8D2A6">
        <circle cx="648" cy="192" r="2.6"/><circle cx="618" cy="300" r="2.6"/><circle cx="608" cy="416" r="2.6"/>
      </g>
      <g fill="#E8E3DA" text-anchor="end">
        <text x="288" y="188">DOUBLE-LAYER COLLAR</text>
        <text x="288" y="296">ZIP HAND POCKET</text>
        <text x="288" y="412">ELASTICATED HEM</text>
      </g>
      <g fill="rgba(232,227,218,0.42)" text-anchor="end" font-size="9">
        <text x="288" y="203">TWO-PIECE / TOPSTITCHED</text>
        <text x="288" y="311">CONCEALED / NO FLAP</text>
        <text x="288" y="427">RUCHED / 28 MM BAND</text>
      </g>

      <!-- leaders: right -->
      <g stroke="#B08D57" stroke-opacity="0.7" stroke-width="1" fill="none">
        <path d="M778,186 H1048"/><path d="M828,338 H1048"/>
      </g>
      <g fill="#E8D2A6"><circle cx="778" cy="186" r="2.6"/><circle cx="828" cy="338" r="2.6"/></g>
      <g fill="#E8E3DA">
        <text x="1060" y="182">DROP SHOULDER</text>
        <text x="1060" y="334">SNAP CUFF</text>
      </g>
      <g fill="rgba(232,227,218,0.42)" font-size="9">
        <text x="1060" y="197">SEAM SITS BELOW BONE</text>
        <text x="1060" y="349">SINGLE / ANTIQUE NICKEL</text>
      </g>

      <!-- dimensions -->
      <g stroke="#E8E3DA" stroke-opacity="0.34" stroke-width="1" fill="none">
        <path d="M470,160 V384 M464,160 H476 M464,384 H476"/>
        <path d="M600,500 H836 M600,494 V506 M836,494 V506"/>
      </g>
      <g fill="rgba(232,227,218,0.6)" font-size="9">
        <text x="428" y="276">68 CM</text>
        <text x="694" y="520">58 CM</text>
      </g>
    </g>
  </svg>

  <!-- readout -->
  <div style="position: absolute; bottom: 92px; left: 48px; right: 48px; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border: 1px solid rgba(232,227,218,0.16);">
    <div style="padding: 18px 22px; border-right: 1px solid rgba(232,227,218,0.16); display: flex; flex-direction: column; gap: 7px;">
      <div style="font-size: 9px; letter-spacing: 0.16em; color: rgba(232,227,218,0.42);">UNIT</div>
      <div style="font-size: 15px; font-weight: 700;">004 / MAILLARD</div>
    </div>
    <div style="padding: 18px 22px; border-right: 1px solid rgba(232,227,218,0.16); display: flex; flex-direction: column; gap: 7px;">
      <div style="font-size: 9px; letter-spacing: 0.16em; color: rgba(232,227,218,0.42);">PRICE</div>
      <div style="font-size: 15px; font-weight: 700; color: #E8D2A6;">AED 97.20</div>
    </div>
    <div style="padding: 18px 22px; border-right: 1px solid rgba(232,227,218,0.16); display: flex; flex-direction: column; gap: 7px;">
      <div style="font-size: 9px; letter-spacing: 0.16em; color: rgba(232,227,218,0.42);">SIZES</div>
      <div style="font-size: 15px; font-weight: 700;">S M <span style="color:#B08D57;">L</span> XL</div>
    </div>
    <div style="padding: 18px 22px; display: flex; flex-direction: column; gap: 7px;">
      <div style="font-size: 9px; letter-spacing: 0.16em; color: rgba(232,227,218,0.42);">DISPATCH</div>
      <div style="font-size: 15px; font-weight: 700;">UAE / 2 DAYS</div>
    </div>
  </div>

  <div style="position: absolute; bottom: 30px; left: 48px; right: 48px; display: flex; justify-content: space-between; align-items: center;">
    <div style="font-size: 10px; letter-spacing: 0.1em; color: rgba(232,227,218,0.42);">CAPRA FALCONERI &middot; FIVE UNITS IN SERIES</div>
    <div style="padding: 13px 30px; background: #B08D57; color: #14120D; font-size: 10px; font-weight: 700; letter-spacing: 0.18em;">ADD TO BAG</div>
  </div>
</div>
</x-dc>
</body>
</html>
